{
  "name": "@machado-repo/ui",
  "version": "0.0.0",
  "sideEffects": [
    "**/*.css"
  ],
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./styles.css": "./dist/index.css"
  },
  "license": "MIT",
  "scripts": {
    "test": "jest --config jest.config.ts --coverage",
    "test:watch": "jest --watchAll",
    "build:styles": "tailwindcss -i ./src/styles.css -o ./dist/index.css",
    "build:components": "tsc -b",
    "check-types": "tsc --noEmit",
    "dev:styles": "tailwindcss -i ./src/styles.css -o ./dist/index.css --watch",
    "dev:components": "tsc --watch",
    "lint": "eslint src --max-warnings 0"
  },
  "peerDependencies": {
    "react": "^19",
    "react-dom": "^19"
  },
  "dependencies": {
    "@machado-repo/i18n": "*",
    "@machado-repo/utils": "*",
    "@machado-repo/shared": "*"
  },
  "devDependencies": {
    "@machado-repo/eslint-config": "*",
    "@machado-repo/jest-config": "*",
    "@machado-repo/tailwind-config": "*",
    "@machado-repo/typescript-config": "*",
    "@machado-repo/theme": "*",
    "@machado-repo/icons": "*",
    "@tailwindcss/cli": "^4.1.5",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/jest": "^30.0.0",
    "@types/react": "^19.1.0",
    "eslint": "^9.39.1",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "tailwindcss": "^4.1.5",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "typescript": "5.9.2"
  }
}
